#without using min and max function

arr=list(map(int, input().split()))
if len(arr)==0:
    print("Array is empty")
else:
    smallest = arr[0]
    largest = arr[0]

    for num in arr:
        if num < smallest:
            smallest = num
        if num > largest:
            largest = num

    print("smallest:", smallest)
    print("largest:" ,largest)